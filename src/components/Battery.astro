---
import type { Cell } from "../lib/charge"
import { cellSummary } from "../lib/charge"

interface Props {
    cells: Cell[]
    decorative?: boolean
    emptyText?: string
    // cells pick that meeting on the calendar, so clicking one shows its details
    selectable?: boolean
}

const { cells, decorative = false, emptyText, selectable = false } = Astro.props
const step = cells.length ? 600 / cells.length : 0

// up to this many cells always sit in one row, and twice as many do on wider screens; more wraps
const ONE_ROW = 60
---

<div class="battery" data-battery aria-hidden={decorative ? "true" : undefined}>
    {
        !decorative && (
            <p class="sr-only">
                {cells.length ? `Battery with one cell per meeting: ${cellSummary(cells)}` : emptyText}
            </p>
        )
    }
    <div class="battery-top" aria-hidden="true">
        <span class="battery-terminal"></span>
        <span class="battery-wire"></span>
        <svg class="battery-pulse" viewBox="0 0 72 30">
            <polyline points="0,15 18,15 23,11 28,15 34,15 41,2 49,24 55,15 72,15"></polyline>
        </svg>
        <span class="battery-wire"></span>
        <span class="battery-terminal"></span>
    </div>
    <div class="battery-case" aria-hidden="true">
        {
            cells.length ? (
                <div
                    class:list={[
                        "battery-cells",
                        cells.length <= ONE_ROW && "battery-cells-row",
                        cells.length <= ONE_ROW * 2 && "battery-cells-wide",
                    ]}
                    style={`--count: ${cells.length}`}
                >
                    {cells.map((cell, index) => {
                        const inner = (
                            <span
                                class={`cell cell-${cell.kind}`}
                                style={`--level: ${cell.level.toFixed(3)}; --delay: ${(index * step).toFixed(0)}ms`}
                                data-label={cell.label || undefined}
                                title={cell.label || undefined}
                            >
                                <i />
                            </span>
                        )

                        if (cell.href)
                            return (
                                <a href={cell.href} tabindex="-1" aria-hidden="true">
                                    {inner}
                                </a>
                            )

                        // the calendar is the keyboard way to pick a meeting, so these stay out of the tab order
                        if (selectable)
                            return (
                                <button type="button" class="cell-button cell-hitbox" tabindex="-1" data-select={cell.key}>
                                    {inner}
                                </button>
                            )

                        if (decorative)
                            return (
                                <div class="cell-hitbox" aria-hidden="true">
                                    {inner}
                                </div>
                            )

                        return inner
                    })}
                </div>
            ) : (
                <p class="battery-empty">{emptyText}</p>
            )
        }
    </div>
    {!decorative && cells.length > 0 && <p class="battery-detail" data-battery-detail hidden />}
</div>

<script>
    // names a cell under the battery when it's hovered or tapped
    document.querySelectorAll<HTMLElement>("[data-battery]").forEach((battery) => {
        const detail = battery.querySelector<HTMLElement>("[data-battery-detail]")
        if (!detail) return

        battery.addEventListener("pointerover", (event) => {
            const target = event.target as Element

            const hitbox = target.closest<HTMLElement>(".cell-hitbox")
            const label = hitbox
                ? hitbox.querySelector<HTMLElement>("[data-label]")?.dataset.label
                : target.closest<HTMLElement>("[data-label]")?.dataset.label
            if (!label) return

            detail.textContent = label
            detail.hidden = false
        })

        battery.addEventListener("pointerleave", () => {
            detail.hidden = true
        })
    })

    // a selectable cell picks its meeting on the calendar, and the calendar's choice is ringed here
    const cellButtons = document.querySelectorAll<HTMLElement>("[data-select]")

    function ringSelected(selected: string | undefined) {
        cellButtons.forEach((button) =>
            button.firstElementChild?.classList.toggle("cell-selected", button.dataset.select === selected),
        )
    }

    cellButtons.forEach((button) => {
        button.addEventListener("click", () => {
            document.dispatchEvent(new CustomEvent("select-meeting", { detail: button.dataset.select }))

            const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches
            document
                .getElementById("day-detail")
                ?.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "nearest" })
        })
    })

    document.addEventListener("meeting-selected", (event) => ringSelected((event as CustomEvent<string>).detail))
    ringSelected(document.documentElement.dataset.selectedMeeting)
</script>
